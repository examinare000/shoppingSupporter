# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=shoppingsupporter
DATABASE_URL=postgresql://postgres:password@db:5432/shoppingsupporter

# Backend
BACKEND_PORT=8000

# Frontend
FRONTEND_PORT=3000

# Analysis
ANALYSIS_PORT=8001

# Amazon Product Advertising API 5.0 (PA-API)
# Why: api/lib/amazon.py が __init__ で必須として読み込む。未設定なら AmazonAPIError。
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=

