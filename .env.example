# Database (Neon Serverless Postgres / ADR-008)
# Why: api/common/database.py が SQLAlchemy エンジン生成時に必須。アプリ側は pooler 付き URL を使う。
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require

# Auth (JWT / ADR-007)
# Why: JWT 署名・検証鍵。本番では十分な長さのランダム値を使い、リポジトリには絶対に置かない。
JWT_SECRET=

# Rakuten Ichiba API
# Why: api/lib/rakuten.py が楽天商品検索 API 呼び出し時に必須。
RAKUTEN_APP_ID=

# Yahoo! Shopping API
# Why: api/lib/yahoo.py が Yahoo! ショッピング商品検索 API 呼び出し時に必須。
YAHOO_CLIENT_ID=

# Amazon Product Advertising API 5.0 (PA-API)
# Why: api/lib/amazon.py が __init__ で必須として読み込む。未設定なら AmazonAPIError。
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=
